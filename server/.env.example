# LakbayLocal Server – Environment Variables
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=lakbaylocal

# JWT
JWT_SECRET=lakbaylocal_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Upload limits
MAX_FILE_SIZE_MB=5
